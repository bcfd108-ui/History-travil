{
  "name": "history-travel-hosted",
  "version": "0.2.0",
  "private": true,
  "description": "History Travel — hosted edition (Stage 2: accounts + saving behind the Stage 1 catalog; dormant until keys are wired at deployment).",
  "scripts": {
    "convert": "node scripts/convert.mjs",
    "dev": "next dev",
    "build": "node scripts/convert.mjs && node scripts/build-navigation.mjs && node scripts/check-maps.mjs && node scripts/check-hunts.mjs && node scripts/check-machine-queue.mjs && next build",
    "queue:build": "node scripts/build-machine-queue.mjs",
    "test:queue": "node --test scripts/machine-queue.test.mjs",
    "start": "next start",
    "check:maps": "node scripts/check-maps.mjs",
    "test:maps": "node --test scripts/maps-core.test.mjs",
    "check:hunts": "node scripts/check-hunts.mjs",
    "test:hunts": "node --test scripts/hunts-core.test.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "next": "^15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "topojson-client": "3.1.0",
    "us-atlas": "3.0.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/topojson-client": "^3.1.5",
    "saxes": "6.0.0",
    "typescript": "^5.6.0"
  }
}
